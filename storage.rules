rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // upload do master pelo admin autenticado
    match /masters/public/{path=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /masters/highlights/{path=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /masters/sessions/{path=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /masters/trail/{path=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /masters/events/{path=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // capas antigas das categorias: o upload passou a ser feito pelo servidor
    // (/api/categories/cover) e o público só vê variants/categories (com marca).
    match /categories/{path=**} {
      allow read, write: if false;
    }

    // variantes públicas servidas ao site
    match /variants/public/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /variants/events/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // destaques, trail e capas de categorias: só cópias com marca de água
    match /variants/highlights/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /variants/trail/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /variants/categories/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /variants/sessions/{path=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
