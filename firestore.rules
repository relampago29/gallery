rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fotos públicas: só lê publicados
    match /public_photos/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // Categorias: leitura aberta (para o admin e, se quiseres, para o site)
    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /highlights/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Eventos: leitura aberta (publicados), escrita via Admin SDK
    match /events/{eventId} {
      allow read: if resource.data.published == true;
      allow write: if false;
      match /photos/{photoId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Pedidos de fotos de eventos: leitura pelo próprio user, escrita via Admin SDK
    match /event_orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Sessões privadas — leitura permitida ao owner e guests autorizados
    match /client_sessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.allowedUids
      );
      allow write: if false;
      match /photos/{photoId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/client_sessions/$(sessionId)).data.ownerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/client_sessions/$(sessionId)).data.allowedUids
        );
        allow write: if false;
      }
    }
    // Pedidos de sessão — leitura pelo utilizador dono
    match /session_orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
